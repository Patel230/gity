# Gity — public frontend configuration (safe to commit; no secrets here).
# There is deliberately NO GitHub token in this file. Users sign in by pasting
# a fine-grained PAT in the browser, stored in localStorage or sessionStorage.
# One-click OAuth login is not possible on GitHub-only hosting: GitHub requires
# a client_secret for code exchange and its login endpoints send no CORS
# headers, so no pure-browser app can complete those flows.

# Base path for project Pages sites (https://<user>.github.io/<repo>/).
# Set to /<repo-name> (e.g. /gity). Leave empty for user/org Pages sites.
# The deploy workflow sets this automatically — you only need it for local
# `npm run build` previews of the Pages layout.
NEXT_PUBLIC_BASE_PATH=

# Link to this repo, shown in the footer/sidebar ("Star on GitHub").
NEXT_PUBLIC_REPO_URL=https://github.com/Patel230/gity
